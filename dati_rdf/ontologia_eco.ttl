<http://example.org/eco-graph/dataset> a void:Dataset, dcat:Dataset ;
    dcterms:title "Opera Persa - grafo RDF dell'attività pubblicistica di Umberto Eco"@it ;
    dcterms:description "Grafo di conoscenza RDF che modella semanticamente gli articoli di Umberto Eco su riviste e quotidiani, e le loro ristampe nelle raccolte curate dallo stesso Eco, con riuso di vocabolari standard (Dublin Core Terms, FaBiO, PRISM, FRBR, FOAF) e un'estensione minima (eco:) per i soli concetti privi di equivalente."@it ;
    dcterms:creator "Michele Marmo"@it ;
    dcterms:modified "2026-09-24"^^xsd:date ;
    owl:versionInfo "1.2" ;
    void:vocabulary dcterms: , fabio: , prism: , frbr: , foaf: , eco: ;
    dcat:theme "digital humanities"@en, "storia della cultura italiana"@it, "linked open data" ;
    void:feature <http://www.w3.org/ns/formats/Turtle> ,
                 <http://www.w3.org/ns/formats/RDF_XML> ,
                 <http://www.w3.org/ns/formats/JSON-LD> ,
                 <http://www.w3.org/ns/formats/N-Triples> .

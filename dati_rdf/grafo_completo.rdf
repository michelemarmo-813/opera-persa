  <rdf:Description rdf:about="http://example.org/eco-graph/schema#estrattoDi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
    <rdfs:label xml:lang="it">estratto di</rdfs:label>
    <rdfs:comment xml:lang="it">Collega un articolo (estratto giornalistico) al libro di cui e' un estratto, da volume a rivista: il libro e' la fonte, l'articolo ne e' un estratto. Semanticamente l'opposto di prism:isVersionOf (vedi il commento sopra), pur avendo lo stesso verso articolo -&gt; libro. Non dipende dalla categoria del libro (eco:tipoLibro): vedi il commento sopra per l'eccezione nota.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/fabio/JournalArticle"/>
    <rdfs:range rdf:resource="http://purl.org/spar/fabio/Book"/>
  </rdf:Description>

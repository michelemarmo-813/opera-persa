  <rdf:Description rdf:about="http://example.org/eco-graph/dataset">
    <rdf:type rdf:resource="http://rdfs.org/ns/void#Dataset"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <dcterms:title xml:lang="it">Opera Persa - grafo RDF dell'attività pubblicistica di Umberto Eco</dcterms:title>
    <dcterms:description xml:lang="it">Grafo di conoscenza RDF che modella semanticamente gli articoli di Umberto Eco su riviste e quotidiani, e le loro ristampe nelle raccolte curate dallo stesso Eco, con riuso di vocabolari standard (Dublin Core Terms, FaBiO, PRISM, FRBR, FOAF) e un'estensione minima (eco:) per i soli concetti privi di equivalente.</dcterms:description>
    <dcterms:creator xml:lang="it">Michele Marmo</dcterms:creator>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-09-24</dcterms:modified>
    <owl:versionInfo>1.2</owl:versionInfo>
    <void:vocabulary rdf:resource="http://purl.org/dc/terms/"/>
    <void:vocabulary rdf:resource="http://purl.org/spar/fabio/"/>
    <void:vocabulary rdf:resource="http://prismstandard.org/namespaces/basic/2.0/"/>
    <void:vocabulary rdf:resource="http://purl.org/vocab/frbr/core#"/>
    <void:vocabulary rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <void:vocabulary rdf:resource="http://example.org/eco-graph/schema#"/>
    <dcat:theme xml:lang="en">digital humanities</dcat:theme>
    <dcat:theme xml:lang="it">storia della cultura italiana</dcat:theme>
    <dcat:theme>linked open data</dcat:theme>
    <void:feature rdf:resource="http://www.w3.org/ns/formats/Turtle"/>
    <void:feature rdf:resource="http://www.w3.org/ns/formats/RDF_XML"/>
    <void:feature rdf:resource="http://www.w3.org/ns/formats/JSON-LD"/>
    <void:feature rdf:resource="http://www.w3.org/ns/formats/N-Triples"/>
  </rdf:Description>

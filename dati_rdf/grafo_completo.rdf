  <rdf:Description rdf:about="http://example.org/eco-graph/schema#rubrica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
    <rdfs:label xml:lang="it">rubrica</rdfs:label>
    <rdfs:comment xml:lang="it">Sezione/rubrica del periodico in cui è apparso l'articolo (es. «La bustina di minerva»). Punta a una risorsa eco:Rubrica (il nome leggibile è nel suo rdfs:label), non più a un semplice letterale stringa: così gli articoli che condividono la stessa rubrica sono collegati esplicitamente nel grafo. Nessun vocabolario riusato ha un termine specifico per le rubriche giornalistiche; la trattiamo come sotto-proprietà di dcterms:subject.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/fabio/JournalArticle"/>
    <rdfs:range rdf:resource="http://example.org/eco-graph/schema#Rubrica"/>
  </rdf:Description>

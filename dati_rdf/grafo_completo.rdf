  <rdf:Description rdf:about="http://example.org/eco-graph/schema#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="it">Ontologia per la bibliografia di Umberto Eco (eco-graph)</rdfs:label>
    <rdfs:comment xml:lang="it">Estensione minima di Dublin Core, FaBiO, PRISM, FRBR e FOAF per modellare gli articoli di Umberto Eco, le riviste su cui sono usciti, e i libri in cui sono stati ripubblicati. Non usa owl:imports (vedi nota sotto): le classi/proprieta' riusate sono referenziate per URI, non reimportate.</rdfs:comment>
    <owl:versionInfo>1.10</owl:versionInfo>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-21</dcterms:modified>
  </rdf:Description>
